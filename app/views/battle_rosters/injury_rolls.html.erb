<% content_for(:body_class) { "bg-stone-950" } %>
<% content_for(:raw_content) { true } %>

<%= render layout: "shared/dark_layout" do %>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 gap-4">
    <div>
      <div class="flex items-center gap-4 mb-3">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-red-700/60"></div>
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-red-600/60" fill="currentColor">
          <path d="M12 9v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-red-700/60"></div>
      </div>
      <h1 class="text-amber-100 tracking-[0.1em] uppercase" style="font-family: 'Cinzel', serif; font-size: 1.8rem; font-weight: 700;">
        Tiradas de Heridas
      </h1>
      <p class="text-amber-400/80 mt-1" style="font-family: 'Cinzel', serif; font-size: 0.9rem;">
        <%= @battle_roster.warband.name %>
      </p>
      <p class="text-stone-500 mt-1" style="font-family: 'Crimson Text', serif;">
        <%= @round.display_name %> &mdash; <%= @matchup.warband_1.name %> vs <%= @matchup.warband_2.name %>
      </p>
    </div>
  </div>

  <%= form_with url: apply_injuries_campaign_campaign_round_matchup_battle_roster_path(@campaign, @round, @matchup, @battle_roster),
                method: :post,
                local: true do |f| %>

    <!-- ========== GUERREROS ========== -->
    <% if @defeated_warriors.any? %>
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-amber-200/80 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.8rem;">Guerreros</h2>
          <div class="flex-1 h-px bg-stone-800/60"></div>
        </div>

        <!-- Tabla resultados guerreros -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm mb-5">
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-red-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">2 – 3</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Muerto</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-orange-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">4 – 5</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Herido (pierde el siguiente combate)</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-emerald-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">6 – 11</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Recuperación completa</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-amber-300" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">12</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Lección aprendida (+1 a +3 XP)</p>
          </div>
        </div>

        <div class="space-y-3">
          <% @defeated_warriors.each do |unit| %>
            <div class="flex flex-wrap items-start gap-4 px-4 py-4 rounded-lg border border-red-900/30 bg-red-950/20"
                 data-member-id="<%= unit.warband_member_id %>">
              <div class="flex-1 min-w-0 pt-1">
                <span class="text-amber-100" style="font-family: 'Cinzel', serif; font-size: 0.9rem;">
                  <%= unit.warband_member.name %>
                </span>
              </div>
              <div class="flex items-center gap-3">
                <label class="text-xs text-amber-200/60 tracking-wider uppercase whitespace-nowrap"
                       style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Resultado</label>
                <input type="number"
                       name="injuries[<%= unit.warband_member_id %>][roll]"
                       min="2" max="12" required
                       class="w-20 bg-stone-900 border border-stone-700/50 rounded py-1.5 px-2 text-stone-200 text-center focus:outline-none focus:ring-2 focus:ring-amber-700"
                       style="font-family: 'Crimson Text', serif; font-size: 1rem;"
                       onchange="handleWarriorRoll(this, '<%= unit.warband_member_id %>')" />
              </div>
              <div id="warrior-bonus-<%= unit.warband_member_id %>" class="hidden flex items-center gap-3">
                <label class="text-xs text-amber-300/70 tracking-wider uppercase whitespace-nowrap"
                       style="font-family: 'Cinzel', serif; font-size: 0.6rem;">XP extra (1–3)</label>
                <input type="number"
                       name="injuries[<%= unit.warband_member_id %>][bonus_xp]"
                       min="1" max="3" value="1"
                       class="w-16 bg-stone-900 border border-amber-800/50 rounded py-1.5 px-2 text-amber-200 text-center focus:outline-none focus:ring-2 focus:ring-amber-700"
                       style="font-family: 'Crimson Text', serif; font-size: 1rem;" />
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- ========== HÉROES ========== -->
    <% if @defeated_heroes.any? %>
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <h2 class="text-amber-200/80 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.8rem;">Héroes</h2>
          <div class="flex-1 h-px bg-stone-800/60"></div>
        </div>

        <!-- Tabla resultados héroes -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-sm mb-5">
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-red-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">2</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Muerte</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-red-300" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">3</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Brazo herido <span class="text-red-400/70">(2ª vez → muerte)</span></p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-orange-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">4</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Pierna herida, –1 Mov <span class="text-red-400/70">(2ª vez → muerte)</span></p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-yellow-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">5</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Deshonrado: sin Stand Fast! <span class="text-red-400/70">(3ª vez → muerte)</span></p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-blue-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">6</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Arañazo (pierde el siguiente combate)</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-emerald-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">7–10</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Recuperación completa (elimina una herida)</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-purple-400" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">11</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Protección de los Valar (+1 Fate)</p>
          </div>
          <div class="px-3 py-2 rounded border border-stone-800/50 bg-stone-900/50">
            <span class="font-bold text-amber-300" style="font-family: 'Cinzel', serif; font-size: 0.7rem;">12</span>
            <p class="text-stone-500 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Heridas de héroe (+1–6 influencia, elimina una herida)</p>
          </div>
        </div>

        <div class="space-y-4">
          <% @defeated_heroes.each do |unit| %>
            <% m = unit.warband_member %>
            <% has_arm = m.arm_injured? %>
            <% has_leg = m.leg_injured? %>
            <% has_disgrace = m.disgrace_count > 0 %>
            <% can_recover = has_arm || has_leg || has_disgrace %>
            <div class="px-4 py-4 rounded-lg border border-red-900/30 bg-red-950/20"
                 data-member-id="<%= m.id %>"
                 data-has-arm="<%= has_arm %>"
                 data-has-leg="<%= has_leg %>"
                 data-has-disgrace="<%= has_disgrace %>">

              <!-- Name + badges -->
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-amber-100" style="font-family: 'Cinzel', serif; font-size: 0.9rem;"><%= m.name %></span>
                <span class="text-xs px-1.5 py-0.5 rounded border text-amber-400/70 border-amber-900/40 bg-amber-900/20"
                      style="font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.1em;">Héroe</span>
                <% if has_arm %>
                  <span class="text-xs px-2 py-0.5 rounded border border-red-800/50 bg-red-900/20 text-red-300"
                        style="font-family: 'Cinzel', serif; font-size: 0.55rem;">Brazo Herido</span>
                <% end %>
                <% if has_leg %>
                  <span class="text-xs px-2 py-0.5 rounded border border-orange-800/50 bg-orange-900/20 text-orange-300"
                        style="font-family: 'Cinzel', serif; font-size: 0.55rem;">Pierna Herida</span>
                <% end %>
                <% if m.disgrace_count > 0 %>
                  <span class="text-xs px-2 py-0.5 rounded border border-yellow-800/50 bg-yellow-900/20 text-yellow-300"
                        style="font-family: 'Cinzel', serif; font-size: 0.55rem;">Deshonrado ×<%= m.disgrace_count %></span>
                <% end %>
              </div>

              <!-- Roll input -->
              <div class="flex flex-wrap items-center gap-4">
                <div class="flex items-center gap-3">
                  <label class="text-xs text-amber-200/60 tracking-wider uppercase whitespace-nowrap"
                         style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Resultado (2–12)</label>
                  <input type="number"
                         name="injuries[<%= m.id %>][roll]"
                         min="2" max="12" required
                         class="w-20 bg-stone-900 border border-stone-700/50 rounded py-1.5 px-2 text-stone-200 text-center focus:outline-none focus:ring-2 focus:ring-amber-700"
                         style="font-family: 'Crimson Text', serif; font-size: 1rem;"
                         onchange="handleHeroRoll(this, '<%= m.id %>')" />
                </div>

                <!-- Resultado 12: influencia (1–6) -->
                <div id="hero-influence-<%= m.id %>" class="hidden flex items-center gap-3">
                  <label class="text-xs text-amber-300/70 tracking-wider uppercase whitespace-nowrap"
                         style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Influencia (1–6)</label>
                  <input type="number"
                         name="injuries[<%= m.id %>][bonus_influence]"
                         min="1" max="6" value="1"
                         class="w-16 bg-stone-900 border border-amber-800/50 rounded py-1.5 px-2 text-amber-200 text-center focus:outline-none focus:ring-2 focus:ring-amber-700"
                         style="font-family: 'Crimson Text', serif; font-size: 1rem;" />
                </div>
              </div>

              <!-- Recuperación (para resultados 7-10 y 12) -->
              <% if can_recover %>
                <div id="hero-recovery-<%= m.id %>" class="hidden mt-3 pt-3 border-t border-stone-800/40">
                  <p class="text-xs text-emerald-400/70 tracking-wider uppercase mb-2"
                     style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Eliminar una herida (opcional)</p>
                  <div class="flex flex-wrap gap-2">
                    <label class="flex items-center gap-2 cursor-pointer px-3 py-1.5 rounded border border-stone-700/40 bg-stone-900/50 hover:border-emerald-700/40 has-[:checked]:border-emerald-600/60 has-[:checked]:bg-emerald-900/20 transition-colors">
                      <input type="radio" name="injuries[<%= m.id %>][recovery_choice]" value="none" checked
                             class="w-3 h-3 accent-emerald-500" />
                      <span class="text-stone-400" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Ninguna</span>
                    </label>
                    <% if has_arm %>
                      <label class="flex items-center gap-2 cursor-pointer px-3 py-1.5 rounded border border-stone-700/40 bg-stone-900/50 hover:border-red-700/40 has-[:checked]:border-red-600/60 has-[:checked]:bg-red-900/20 transition-colors">
                        <input type="radio" name="injuries[<%= m.id %>][recovery_choice]" value="arm"
                               class="w-3 h-3 accent-red-400" />
                        <span class="text-red-300/80" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Brazo herido</span>
                      </label>
                    <% end %>
                    <% if has_leg %>
                      <label class="flex items-center gap-2 cursor-pointer px-3 py-1.5 rounded border border-stone-700/40 bg-stone-900/50 hover:border-orange-700/40 has-[:checked]:border-orange-600/60 has-[:checked]:bg-orange-900/20 transition-colors">
                        <input type="radio" name="injuries[<%= m.id %>][recovery_choice]" value="leg"
                               class="w-3 h-3 accent-orange-400" />
                        <span class="text-orange-300/80" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Pierna herida (+1 Mov)</span>
                      </label>
                    <% end %>
                    <% if has_disgrace %>
                      <label class="flex items-center gap-2 cursor-pointer px-3 py-1.5 rounded border border-stone-700/40 bg-stone-900/50 hover:border-yellow-700/40 has-[:checked]:border-yellow-600/60 has-[:checked]:bg-yellow-900/20 transition-colors">
                        <input type="radio" name="injuries[<%= m.id %>][recovery_choice]" value="disgrace"
                               class="w-3 h-3 accent-yellow-400" />
                        <span class="text-yellow-300/80" style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">Deshonrado (–1 nivel)</span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>

            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3">
      <%= f.submit "Aplicar Resultados",
          class: "px-6 py-2 bg-gradient-to-b from-amber-700 to-amber-900 text-amber-100 rounded border border-amber-600/50 hover:from-amber-600 hover:to-amber-800 transition-all shadow-lg shadow-amber-900/30 cursor-pointer",
          style: "font-family: 'Cinzel', serif; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.7rem;" %>
    </div>

  <% end %>

  <script>
    function handleWarriorRoll(input, memberId) {
      var bonus = document.getElementById('warrior-bonus-' + memberId);
      bonus.classList.toggle('hidden', parseInt(input.value) !== 12);
    }

    function handleHeroRoll(input, memberId) {
      var roll = parseInt(input.value);
      var influenceDiv = document.getElementById('hero-influence-' + memberId);
      var recoveryDiv  = document.getElementById('hero-recovery-' + memberId);

      if (influenceDiv) influenceDiv.classList.toggle('hidden', roll !== 12);
      if (recoveryDiv)  recoveryDiv.classList.toggle('hidden', !(roll >= 7 && roll <= 10) && roll !== 12);
    }
  </script>
<% end %>
