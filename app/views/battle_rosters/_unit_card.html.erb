<div id="<%= dom_id(unit) %>" class="rounded-lg border overflow-hidden transition-all duration-300 <%= unit.defeated? ? 'border-red-900/40 opacity-60' : 'border-amber-300/60 hover:border-amber-500/70' %> bg-gradient-to-b from-white to-amber-50/60">
  <!-- Unit Header -->
  <div class="px-4 py-3 border-b <%= unit.defeated? ? 'border-red-900/30 bg-red-950/30' : 'border-stone-200/80 bg-stone-900/50' %>">
    <div class="flex justify-between items-center">
      <div>
        <h3 class="text-stone-800" style="font-family: 'Cinzel', serif; font-size: 0.95rem;"><%= unit.warband_member.name %></h3>
        <span class="inline-block text-xs px-2 py-0.5 rounded mt-1 <%= unit.warband_member.hero? ? 'text-amber-700 border border-amber-300/60 bg-amber-100/60' : 'text-stone-600 border border-stone-300/60 bg-stone-100/60' %>" style="font-family: 'Cinzel', serif; font-size: 0.55rem; letter-spacing: 0.1em;">
          <%= unit.warband_member.display_type %>
        </span>
      </div>
      <% if unit.defeated? %>
        <span class="px-3 py-1 text-xs text-red-400 border border-red-300/60 rounded bg-red-50/80 font-bold" style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.1em;">
          DERROTADO
        </span>
      <% end %>
    </div>
  </div>

  <!-- Tabs nav -->
  <div class="flex gap-0 border-b border-stone-200/80 bg-stone-900/30">
    <button onclick="showUnitTab(<%= unit.id %>, 'estado')" id="unit-tab-btn-estado-<%= unit.id %>"
            class="unit-tab-btn-<%= unit.id %> px-3 py-2 text-amber-600 border-b-2 border-amber-500 -mb-px flex-1"
            style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;">
      Estado
    </button>
    <button onclick="showUnitTab(<%= unit.id %>, 'equipo')" id="unit-tab-btn-equipo-<%= unit.id %>"
            class="unit-tab-btn-<%= unit.id %> px-3 py-2 text-stone-500 border-b-2 border-transparent hover:text-stone-600 transition-colors -mb-px flex-1"
            style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;">
      Equipo (<%= unit.warband_member.warband_equipments.count %>)
    </button>
    <button onclick="showUnitTab(<%= unit.id %>, 'skills')" id="unit-tab-btn-skills-<%= unit.id %>"
            class="unit-tab-btn-<%= unit.id %> px-3 py-2 text-stone-500 border-b-2 border-transparent hover:text-stone-600 transition-colors -mb-px flex-1"
            style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase;">
      Skills (<%= unit.warband_member.warband_skills.count %>)
    </button>
  </div>

  <!-- ===== PANEL: ESTADO ===== -->
  <div id="unit-panel-estado-<%= unit.id %>" class="px-4 py-4">

    <!-- Wounds Tracker -->
    <div class="text-center mb-4">
      <p class="text-xs text-stone-800 tracking-wider uppercase mb-2" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Heridas</p>
      <div class="flex items-center justify-center gap-4">
        <% if @battle_roster.active? %>
          <%= button_to wound_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              method: :patch,
              class: "inline-flex items-center justify-center w-10 h-10 rounded-full #{unit.defeated? ? 'bg-amber-50/80 text-stone-600 cursor-not-allowed' : 'bg-red-900/30 text-red-400 hover:bg-red-900/50 border border-red-300/60'} text-xl font-bold transition-colors",
              disabled: unit.defeated? do %>
            -
          <% end %>
        <% end %>

        <div class="text-center">
          <span class="text-4xl font-bold <%= unit.defeated? ? 'text-red-500' : (unit.current_wounds <= 1 && unit.max_wounds > 1 ? 'text-orange-400' : 'text-stone-800') %>" style="font-family: 'Cinzel', serif;">
            <%= unit.current_wounds %>
          </span>
          <span class="text-xl text-stone-600" style="font-family: 'Cinzel', serif;"> / <%= unit.max_wounds %></span>
        </div>

        <% if @battle_roster.active? %>
          <%= button_to heal_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              method: :patch,
              class: "inline-flex items-center justify-center w-10 h-10 rounded-full #{unit.current_wounds >= unit.max_wounds ? 'bg-amber-50/80 text-stone-600 cursor-not-allowed' : 'bg-emerald-900/30 text-emerald-400 hover:bg-emerald-900/50 border border-emerald-300/60'} text-xl font-bold transition-colors",
              disabled: unit.current_wounds >= unit.max_wounds do %>
            +
          <% end %>
        <% end %>
      </div>

      <!-- Wound Pips -->
      <div class="flex justify-center gap-1 mt-3">
        <% unit.max_wounds.times do |i| %>
          <div class="w-4 h-4 rounded-full border-2 <%= i < unit.current_wounds ? 'bg-red-600 border-red-500' : 'bg-stone-800 border-stone-700' %>"></div>
        <% end %>
      </div>
    </div>

    <!-- Might / Will / Fate -->
    <% if unit.has_spendable? %>
      <div class="mt-4 pt-4 border-t border-stone-200/80 space-y-2">
        <% [["might", "M", "text-yellow-400", "border-yellow-800/40", "bg-yellow-100/60", "hover:bg-yellow-900/50"],
            ["will",  "W", "text-blue-400",   "border-blue-800/40",   "bg-blue-900/30",   "hover:bg-blue-900/50"],
            ["fate",  "F", "text-purple-400", "border-purple-800/40", "bg-purple-900/30", "hover:bg-purple-900/50"]].each do |attr, label, color, border, bg, hover| %>
          <% max = unit.warband_member.send(attr) %>
          <% next if max == 0 %>
          <% current = unit.send(:"current_#{attr}") %>
          <div class="flex items-center gap-2">
            <span class="w-4 text-center text-xs font-bold <%= color %>" style="font-family: 'Cinzel', serif; font-size: 0.6rem;"><%= label %></span>
            <% if @battle_roster.active? %>
              <%= button_to spend_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
                  @campaign, @round, @matchup, @battle_roster, unit),
                  params: { attribute: attr },
                  method: :patch,
                  class: "inline-flex items-center justify-center w-6 h-6 rounded-full text-sm font-bold transition-colors #{current <= 0 ? 'bg-amber-50/80 text-stone-600 cursor-not-allowed' : "#{bg} #{color} #{hover} #{border} border"}",
                  disabled: current <= 0 do %>
                -
              <% end %>
            <% end %>
            <div class="flex gap-1">
              <% max.times do |i| %>
                <div class="w-3 h-3 rounded-full border <%= i < current ? "#{bg} #{border} border" : 'bg-stone-800 border-stone-700' %>"></div>
              <% end %>
            </div>
            <span class="text-xs <%= color %>" style="font-family: 'Crimson Text', serif;"><%= current %>/<%= max %></span>
            <% if @battle_roster.active? %>
              <%= button_to restore_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
                  @campaign, @round, @matchup, @battle_roster, unit),
                  params: { attribute: attr },
                  method: :patch,
                  class: "inline-flex items-center justify-center w-6 h-6 rounded-full text-sm font-bold transition-colors #{current >= max ? 'bg-amber-50/80 text-stone-600 cursor-not-allowed' : "#{bg} #{color} #{hover} #{border} border"}",
                  disabled: current >= max do %>
                +
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Battle Ticks -->
    <div class="mt-4 pt-4 border-t border-stone-200/80">
      <p class="text-xs text-stone-800 tracking-wider uppercase mb-2 text-center" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Logros</p>
      <div class="space-y-1">
        <% ticks = [["wounded_enemy", "Hirió a un enemigo"]]
        ticks << ["fate_protected", "Evitó herida con Fate"] if unit.warband_member.fate > 0
        ticks += [["courage_broken", "Superó coraje estando Roto"]] if !@battle_roster.active? || !@battle_roster.broken?
        ticks.each do |tick, label| %>
          <% checked = unit.public_send(tick) %>
          <% if !@battle_roster.active? %>
            <div class="w-full flex items-center gap-2 px-2 py-1.5 rounded border <%= checked ? 'bg-amber-100/70 border-amber-700/50 text-amber-600' : 'bg-stone-900/50 border-stone-200/70 text-stone-500' %>">
              <span class="flex-shrink-0 w-4 h-4 rounded border-2 flex items-center justify-center <%= checked ? 'border-amber-500 bg-amber-600/40' : 'border-stone-600' %>">
                <% if checked %>
                  <svg class="w-2.5 h-2.5 text-amber-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2,6 5,9 10,3"/>
                  </svg>
                <% end %>
              </span>
              <span style="font-family: 'Crimson Text', serif; font-size: 0.85rem;"><%= label %></span>
            </div>
          <% else %>
            <%= button_to toggle_tick_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
                @campaign, @round, @matchup, @battle_roster, unit),
                params: { tick: tick },
                method: :patch,
                class: "w-full flex items-center gap-2 px-2 py-1.5 rounded border transition-colors #{checked ? 'bg-amber-100/70 border-amber-700/50 text-amber-600' : 'bg-stone-900/50 border-stone-200/70 text-stone-500 hover:border-stone-600/50 hover:text-stone-600'}" do %>
              <span class="flex-shrink-0 w-4 h-4 rounded border-2 flex items-center justify-center <%= checked ? 'border-amber-500 bg-amber-600/40' : 'border-stone-600' %>">
                <% if checked %>
                  <svg class="w-2.5 h-2.5 text-amber-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="2,6 5,9 10,3"/>
                  </svg>
                <% end %>
              </span>
              <span style="font-family: 'Crimson Text', serif; font-size: 0.85rem;"><%= label %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if !@battle_roster.active? %>
      <!-- Resultado Final (solo lectura) -->
      <div class="mt-4 pt-4 border-t border-stone-200/80">
        <p class="text-xs text-stone-800 tracking-wider uppercase mb-2 text-center" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Fin de Batalla</p>
        <div class="space-y-1">
          <div class="w-full flex items-center gap-2 px-2 py-1.5 rounded border <%= unit.on_objective ? 'bg-amber-100/70 border-amber-700/50 text-amber-600' : 'bg-stone-900/50 border-stone-200/70 text-stone-500' %>">
            <span class="flex-shrink-0 w-4 h-4 rounded border-2 flex items-center justify-center <%= unit.on_objective ? 'border-amber-500 bg-amber-600/40' : 'border-stone-600' %>">
              <% if unit.on_objective %>
                <svg class="w-2.5 h-2.5 text-amber-600" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="2,6 5,9 10,3"/>
                </svg>
              <% end %>
            </span>
            <span style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">En un objetivo</span>
          </div>
          <div class="w-full flex items-center gap-2 px-2 py-1.5 rounded border <%= unit.mvp ? 'bg-yellow-900/40 border-yellow-600/60 text-yellow-300' : 'bg-stone-900/50 border-stone-200/70 text-stone-500' %>">
            <span class="flex-shrink-0 w-4 h-4 flex items-center justify-center">
              <svg viewBox="0 0 24 24" class="w-4 h-4 <%= unit.mvp ? 'text-yellow-400' : 'text-stone-600' %>" fill="currentColor">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </span>
            <span style="font-family: 'Crimson Text', serif; font-size: 0.85rem;">MVP</span>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Test de Coraje (solo cuando banda rota y unidad viva) -->
    <% if @battle_roster.active? && @battle_roster.broken? && !unit.defeated? %>
      <div class="mt-4 pt-4 border-t border-red-900/40">
        <p class="text-xs text-red-400/80 tracking-wider uppercase mb-2 text-center" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">
          Test de Coraje
          <span class="ml-1 text-red-700/60">(C: <%= unit.warband_member.coraje %>)</span>
        </p>
        <div class="flex gap-2">
          <%= button_to toggle_tick_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              params: { tick: "courage_broken" },
              method: :patch,
              class: "flex-1 px-2 py-2 rounded border text-xs font-bold tracking-wider uppercase transition-colors #{unit.courage_broken ? 'bg-emerald-900/40 border-emerald-700/60 text-emerald-300' : 'bg-stone-900/50 border-stone-300/60 text-stone-600 hover:border-emerald-800/50 hover:text-emerald-400'}",
              style: "font-family: 'Cinzel', serif; font-size: 0.6rem;" do %>
            <% if unit.courage_broken %>✓ Superó<% else %>Superó<% end %>
          <% end %>
          <%= button_to flee_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              method: :patch,
              class: "flex-1 px-2 py-2 rounded border border-red-800/50 bg-red-950/30 text-red-400 hover:bg-red-900/30 hover:border-red-700/60 text-xs font-bold tracking-wider uppercase transition-colors",
              style: "font-family: 'Cinzel', serif; font-size: 0.6rem;" do %>
            Huye
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Bajas -->
    <div class="mt-4 pt-4 border-t border-stone-200/80">
      <p class="text-xs text-stone-800 tracking-wider uppercase mb-2 text-center" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Heroes o monstruos eliminados</p>
      <div class="flex items-center justify-center gap-3">
        <% if @battle_roster.active? %>
          <%= button_to unkill_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              method: :patch,
              class: "inline-flex items-center justify-center w-6 h-6 rounded-full text-sm font-bold transition-colors #{unit.kills <= 0 ? 'bg-amber-50/80 text-stone-600 cursor-not-allowed' : 'bg-red-900/30 text-red-400 hover:bg-red-900/50 border border-red-300/60'}",
              disabled: unit.kills <= 0 do %>
            −
          <% end %>
        <% end %>
        <span class="text-red-400 font-bold" style="font-family: 'Cinzel', serif; font-size: 1.1rem;"><%= unit.kills %></span>
        <% if @battle_roster.active? %>
          <%= button_to kill_campaign_campaign_round_matchup_battle_roster_battle_roster_unit_path(
              @campaign, @round, @matchup, @battle_roster, unit),
              method: :patch,
              class: "inline-flex items-center justify-center w-6 h-6 rounded-full text-sm font-bold transition-colors bg-red-900/30 text-red-400 hover:bg-red-900/50 border border-red-300/60" do %>
            +
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Stats Summary -->
    <div class="grid grid-cols-3 gap-1 text-xs mt-3 pt-3 border-t border-stone-200/80">
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">Mov</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.movimiento %>"</span>
      </div>
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">L</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.lucha %>+</span>
      </div>
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">F</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.fuerza %></span>
      </div>
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">D</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.defensa %></span>
      </div>
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">A</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.ataques %></span>
      </div>
      <div class="bg-white/80 p-1.5 rounded text-center border border-stone-800/30">
        <span class="font-semibold text-stone-700/50 block" style="font-family: 'Cinzel', serif; font-size: 0.5rem;">C</span>
        <span class="text-stone-600" style="font-family: 'Crimson Text', serif;"><%= unit.warband_member.coraje %></span>
      </div>
    </div>
  </div>

  <!-- ===== PANEL: EQUIPO ===== -->
  <div id="unit-panel-equipo-<%= unit.id %>" class="hidden px-4 py-4">
    <% equipments = unit.warband_member.warband_equipments %>
    <% if equipments.any? %>
      <div class="space-y-2">
        <% equipments.each do |equipment| %>
          <div class="rounded border border-stone-200/80 bg-stone-900/40 p-3">
            <div class="flex items-start gap-2 flex-wrap">
              <p class="text-stone-800 flex-1" style="font-family: 'Cinzel', serif; font-size: 0.85rem;"><%= equipment.name %></p>
              <span class="px-1.5 py-0.5 text-xs text-blue-700 border border-blue-300/50 rounded bg-blue-100/50 tracking-wider uppercase flex-shrink-0" style="font-family: 'Cinzel', serif; font-size: 0.55rem;"><%= equipment.display_type %></span>
            </div>
            <% if equipment.description.present? %>
              <p class="mt-1 text-stone-600 text-xs" style="font-family: 'Crimson Text', serif;"><%= equipment.description %></p>
            <% end %>
            <% if equipment.has_modifiers? %>
              <p class="mt-1 text-stone-500 text-xs" style="font-family: 'Crimson Text', serif;"><%= equipment.modifier_summary %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-stone-600 text-xs text-center py-4" style="font-family: 'Crimson Text', serif;">Sin equipo asignado</p>
    <% end %>
  </div>

  <!-- ===== PANEL: SKILLS ===== -->
  <div id="unit-panel-skills-<%= unit.id %>" class="hidden px-4 py-4">
    <% skills = unit.warband_member.warband_skills %>
    <% if skills.any? %>
      <div class="space-y-2">
        <% skills.each do |skill| %>
          <div class="rounded border border-stone-200/80 bg-stone-900/40 p-3">
            <div class="flex items-start gap-2 flex-wrap">
              <p class="text-stone-800 flex-1" style="font-family: 'Cinzel', serif; font-size: 0.85rem;"><%= skill.name %></p>
              <span class="px-1.5 py-0.5 text-xs text-purple-700 border border-purple-900/30 rounded bg-purple-100/50 tracking-wider uppercase flex-shrink-0" style="font-family: 'Cinzel', serif; font-size: 0.55rem;"><%= skill.display_type %></span>
            </div>
            <% if skill.description.present? %>
              <p class="mt-1 text-stone-600 text-xs" style="font-family: 'Crimson Text', serif;"><%= skill.description %></p>
            <% end %>
            <% if skill.has_modifiers? %>
              <p class="mt-1 text-stone-500 text-xs" style="font-family: 'Crimson Text', serif;"><%= skill.modifier_summary %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-stone-600 text-xs text-center py-4" style="font-family: 'Crimson Text', serif;">Sin skills asignadas</p>
    <% end %>
  </div>
</div>

<script>
  if (typeof showUnitTab === 'undefined') {
    function showUnitTab(unitId, name) {
      ['estado', 'equipo', 'skills'].forEach(function(tab) {
        var panel = document.getElementById('unit-panel-' + tab + '-' + unitId);
        if (panel) panel.classList.toggle('hidden', tab !== name);
      });
      ['estado', 'equipo', 'skills'].forEach(function(tab) {
        var btn = document.getElementById('unit-tab-btn-' + tab + '-' + unitId);
        if (!btn) return;
        if (tab === name) {
          btn.classList.remove('text-stone-500', 'border-transparent');
          btn.classList.add('text-amber-600', 'border-amber-500');
        } else {
          btn.classList.remove('text-amber-600', 'border-amber-500');
          btn.classList.add('text-stone-500', 'border-transparent');
        }
      });
    }
  }
</script>
