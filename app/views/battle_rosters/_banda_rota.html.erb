<div id="banda_rota_<%= battle_roster.id %>">
  <% if battle_roster.active? && battle_roster.broken? %>
    <div class="mb-6 px-5 py-4 rounded-lg border border-red-700/60 bg-red-950/40 flex items-center gap-4">
      <svg viewBox="0 0 24 24" class="w-6 h-6 text-red-500 flex-shrink-0" fill="currentColor">
        <path d="M12 2L1 21h22L12 2zm0 3.5L20.5 19h-17L12 5.5zM11 10v4h2v-4h-2zm0 6v2h2v-2h-2z"/>
      </svg>
      <div>
        <p class="text-red-700 font-bold tracking-widest uppercase" style="font-family: 'Cinzel', serif; font-size: 0.8rem;">¡Banda Rota!</p>
        <p class="text-red-400/70 mt-0.5" style="font-family: 'Crimson Text', serif; font-size: 0.95rem;">Cada unidad en pie debe superar un test de coraje o huir del campo de batalla.</p>
      </div>
    </div>
  <% end %>
</div>
