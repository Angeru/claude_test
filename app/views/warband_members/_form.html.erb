<%= form_with model: [@warband, member], class: "space-y-6" do |form| %>
  <% if member.errors.any? %>
    <div class="rounded-lg border border-red-300/60 bg-red-50/80 p-4">
      <h3 class="text-red-700 font-semibold mb-2" style="font-family: 'Cinzel', serif; font-size: 0.85rem;"><%= pluralize(member.errors.count, "error") %> impidieron guardar:</h3>
      <ul class="list-disc list-inside text-red-400/80 text-sm space-y-1" style="font-family: 'Crimson Text', serif;">
        <% member.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Basic Info -->
  <div class="rounded-lg border border-amber-300/60 bg-gradient-to-b from-white to-amber-50/60 p-6">
    <div class="flex items-center gap-3 mb-5">
      <div class="h-px w-6 bg-amber-800/40"></div>
      <h3 class="text-stone-700 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.85rem;">Informacion Basica</h3>
      <div class="h-px flex-1 bg-amber-800/40"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <%= form.label :name, "Nombre",
            class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
            style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
        <%= form.text_field :name,
            class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 placeholder-stone-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
            style: "font-family: 'Crimson Text', serif;",
            required: true,
            placeholder: "Ej: Aragorn" %>
      </div>

      <div>
        <%= form.label :member_type, "Tipo",
            class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
            style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
        <%= form.select :member_type,
            options_for_select([["Guerrero", "warrior"], ["Heroe", "hero"]], member.member_type),
            {},
            class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
            style: "font-family: 'Crimson Text', serif;" %>
      </div>

      <div>
        <p class="block text-stone-700 text-xs tracking-widest uppercase mb-2"
           style="font-family: 'Cinzel', serif; font-size: 0.65rem;">Experiencia</p>
        <% if member.new_record? %>
          <div class="w-full py-2.5 px-4 bg-stone-200/40 border border-stone-200/70 rounded text-stone-600 cursor-not-allowed"
               style="font-family: 'Crimson Text', serif;">
            <%= member.experience %>
          </div>
        <% else %>
          <div class="flex items-stretch gap-2">
            <button type="button" onclick="adjustExperience(-1)"
                    class="shrink-0 w-10 flex items-center justify-center bg-white/90 border border-stone-300 rounded text-amber-700 text-lg leading-none hover:bg-amber-100/60 hover:border-amber-500 transition-colors"
                    aria-label="Restar experiencia">−</button>
            <%= form.number_field :experience,
                id: "warband_member_experience",
                min: 0, step: 1,
                class: "w-full text-center py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
                style: "font-family: 'Crimson Text', serif;" %>
            <button type="button" onclick="adjustExperience(1)"
                    class="shrink-0 w-10 flex items-center justify-center bg-white/90 border border-stone-300 rounded text-amber-700 text-lg leading-none hover:bg-amber-100/60 hover:border-amber-500 transition-colors"
                    aria-label="Sumar experiencia">+</button>
          </div>
        <% end %>
      </div>

      <div>
        <%= form.label :rank, "Rango",
            class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
            style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
        <%= form.select :rank,
            options_for_select([["Sin Rango", ""], ["Capitán", "capitan"], ["Sargento", "sargento"]], member.rank.to_s),
            {},
            class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
            style: "font-family: 'Crimson Text', serif;" %>
        <p class="text-stone-500 text-xs mt-1" style="font-family: 'Crimson Text', serif;">Solo para héroes. Máx. 1 Capitán y 2 Sargentos por warband.</p>
      </div>

      <div>
        <%= form.label :path, "Camino",
            class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
            style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
        <%= form.select :path,
            options_for_select([["Sin Camino", ""]] + WarbandMember::PATHS_LABELS.map { |v, l| [l, v] }, member.path.to_s),
            {},
            class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
            style: "font-family: 'Crimson Text', serif;" %>
        <p class="text-stone-500 text-xs mt-1" style="font-family: 'Crimson Text', serif;">Solo para héroes.</p>
      </div>

      <div>
        <%= form.label :ranking, "Ranking",
            class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
            style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
        <%= form.number_field :ranking,
            class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 placeholder-stone-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
            style: "font-family: 'Crimson Text', serif;",
            min: 0, required: true %>
      </div>
    </div>

    <% if member.persisted? %>
      <div class="mt-5 flex items-center justify-between rounded border border-emerald-300/60 bg-emerald-100/50 px-4 py-3"
           data-gear-cost="<%= member.gear_cost %>">
        <span class="text-stone-700 text-xs tracking-widest uppercase" style="font-family: 'Cinzel', serif; font-size: 0.65rem;">
          Ranking total
        </span>
        <span id="member_total_ranking" class="text-emerald-700 text-lg font-semibold" style="font-family: 'Cinzel', serif;">
          <%= member.total_ranking %>
        </span>
      </div>
    <% end %>
  </div>

  <!-- Combat Stats -->
  <div class="rounded-lg border border-amber-300/60 bg-gradient-to-b from-white to-amber-50/60 p-6">
    <div class="flex items-center gap-3 mb-5">
      <div class="h-px w-6 bg-amber-800/40"></div>
      <h3 class="text-stone-700 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.85rem;">Caracteristicas de Combate</h3>
      <div class="h-px flex-1 bg-amber-800/40"></div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <% [
        [:movimiento, "Movimiento", 0, 12],
        [:lucha, "Lucha (L)", 1, 10],
        [:proyectiles, "Proyectiles (P)", 1, 10],
        [:fuerza, "Fuerza (F)", 1, 10],
        [:defensa, "Defensa (D)", 1, 10],
        [:ataques, "Ataques (A)", 1, 10],
        [:heridas, "Heridas (H)", 1, 10],
        [:coraje, "Coraje (C)", 1, 10],
        [:inteligencia, "Inteligencia (I)", 1, 10]
      ].each do |field, label, min_val, max_val| %>
        <div>
          <%= form.label field, label,
              class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
              style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
          <%= form.number_field field,
              class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 placeholder-stone-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
              style: "font-family: 'Crimson Text', serif;",
              min: min_val, max: max_val, required: true %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Hero Stats (Might, Will, Fate) -->
  <div class="rounded-lg border border-amber-800/30 bg-gradient-to-b from-amber-950/30 to-amber-50/80 p-6">
    <div class="flex items-center gap-3 mb-2">
      <div class="h-px w-6 bg-amber-700/40"></div>
      <h3 class="text-amber-600 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.85rem;">Puntos Heroicos</h3>
      <div class="h-px flex-1 bg-amber-700/40"></div>
    </div>
    <p class="text-stone-500 text-sm mb-5" style="font-family: 'Crimson Text', serif;">Solo para heroes (deja en 0 para guerreros)</p>

    <div class="grid grid-cols-3 gap-4">
      <% [[:might, "Might"], [:will, "Will"], [:fate, "Fate"]].each do |field, label| %>
        <div>
          <%= form.label field, label,
              class: "block text-stone-700 text-xs tracking-widest uppercase mb-2",
              style: "font-family: 'Cinzel', serif; font-size: 0.65rem;" %>
          <%= form.number_field field,
              class: "w-full py-2.5 px-4 bg-white/90 border border-stone-300 rounded text-stone-800 placeholder-stone-600 focus:outline-none focus:border-amber-500 focus:ring-1 focus:ring-amber-500/30 transition-colors",
              style: "font-family: 'Crimson Text', serif;",
              min: 0, max: 10, required: true %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center justify-between pt-2">
    <%= form.submit member.new_record? ? "Crear Miembro" : "Actualizar Miembro",
        class: "px-6 py-2.5 bg-gradient-to-b from-amber-700 to-amber-900 text-white rounded border border-amber-600/50 hover:from-amber-600 hover:to-amber-800 transition-all shadow-lg shadow-amber-200/60 cursor-pointer",
        style: "font-family: 'Cinzel', serif; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.75rem;" %>
    <%= link_to "Cancelar", warband_warband_members_path(@warband),
        class: "text-stone-600 hover:text-amber-700 transition-colors tracking-wider uppercase",
        style: "font-family: 'Cinzel', serif; font-size: 0.75rem;" %>
  </div>
<% end %>

<script>
  function adjustExperience(delta) {
    var input = document.getElementById('warband_member_experience');
    if (!input) return;
    var value = parseInt(input.value, 10);
    if (isNaN(value)) value = 0;
    value += delta;
    if (value < 0) value = 0;
    input.value = value;
  }

  (function() {
    var label = document.getElementById('member_total_ranking');
    if (!label) return;

    function intVal(id) {
      var el = document.getElementById(id);
      var n = el ? parseInt(el.value, 10) : 0;
      return isNaN(n) ? 0 : n;
    }

    function updateTotalRanking() {
      var gearCost = parseInt(label.parentElement.dataset.gearCost, 10) || 0;
      var ranking = intVal('warband_member_ranking');
      var heroic = (intVal('warband_member_might') + intVal('warband_member_will') + intVal('warband_member_fate')) * 5;
      label.textContent = ranking + gearCost + heroic;
    }

    ['warband_member_ranking', 'warband_member_might', 'warband_member_will', 'warband_member_fate'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.addEventListener('input', updateTotalRanking);
    });

    updateTotalRanking();
  })();
</script>
