<div class="group relative rounded-lg overflow-hidden border border-amber-900/30 bg-gradient-to-b from-stone-900/80 to-stone-950/80 hover:border-amber-700/50 transition-all duration-500">
  <div class="absolute inset-0 bg-gradient-to-b from-amber-900/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
  <div class="relative p-6">
    <div class="flex justify-between items-start mb-4">
      <div>
        <h3 class="text-amber-100 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 1rem;"><%= member.name %></h3>
        <div class="flex gap-2 mt-2 flex-wrap">
          <span class="px-2 py-1 text-xs tracking-wider uppercase rounded <%= member.hero? ? 'text-amber-400/80 border border-amber-900/40 bg-amber-900/20' : 'text-stone-400/80 border border-stone-700/40 bg-stone-800/30' %>" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">
            <%= member.display_type %>
          </span>
          <% if member.rank == "capitan" %>
            <span class="px-2 py-1 text-xs tracking-wider uppercase rounded text-yellow-300/90 border border-yellow-600/50 bg-yellow-900/30" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">
              ★ Capitán
            </span>
          <% elsif member.rank == "sargento" %>
            <span class="px-2 py-1 text-xs tracking-wider uppercase rounded text-orange-300/80 border border-orange-700/40 bg-orange-900/20" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">
              ⬡ Sargento
            </span>
          <% end %>
          <% if member.path.present? %>
            <span class="px-2 py-1 text-xs tracking-wider uppercase rounded text-teal-300/80 border border-teal-800/40 bg-teal-900/20" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">
              ⟁ <%= member.display_path %>
            </span>
          <% end %>
          <span class="px-2 py-1 text-xs text-purple-400/80 border border-purple-900/40 rounded bg-purple-900/20" style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.05em;">
            XP: <%= member.experience %>
          </span>
        </div>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-3 gap-2 text-sm mb-4">
      <% [
        ["Mov", member.movimiento, '"', "movimiento"],
        ["L", member.lucha, '+', "lucha"],
        ["P", member.proyectiles, '+', "proyectiles"],
        ["F", member.fuerza, '', "fuerza"],
        ["D", member.defensa, '', "defensa"],
        ["A", member.ataques, '', "ataques"],
        ["H", member.heridas, '', "heridas"],
        ["C", member.coraje, '', "coraje"],
        ["I", member.inteligencia, '', "inteligencia"]
      ].each do |label, value, suffix, stat_key| %>
        <% modifier = member.total_modifier(stat_key) %>
        <div class="bg-stone-800/50 border border-stone-700/30 p-2 rounded">
          <span class="font-semibold block text-amber-600/70 text-xs" style="font-family: 'Cinzel', serif; font-size: 0.6rem;"><%= label %></span>
          <span class="text-stone-300" style="font-family: 'Crimson Text', serif;"><%= value %><%= suffix %><% if modifier != 0 %><span class="text-amber-400/70 text-xs ml-1">(<%= modifier > 0 ? "+#{modifier}" : modifier.to_s %>)</span><% end %></span>
        </div>
      <% end %>
    </div>

    <!-- Hero Stats -->
    <% if member.might > 0 || member.will > 0 || member.fate > 0 %>
      <div class="grid grid-cols-3 gap-2 text-sm mb-4 border-t border-stone-800/50 pt-3">
        <% might_mod = member.total_modifier("might") %>
        <div class="bg-purple-900/20 border border-purple-800/30 p-2 rounded">
          <span class="font-semibold block text-purple-400/70 text-xs" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Might</span>
          <span class="text-purple-200" style="font-family: 'Crimson Text', serif;"><%= member.might %><% if might_mod != 0 %><span class="text-amber-400/70 text-xs ml-1">(<%= might_mod > 0 ? "+#{might_mod}" : might_mod.to_s %>)</span><% end %></span>
        </div>
        <% will_mod = member.total_modifier("will") %>
        <div class="bg-blue-900/20 border border-blue-800/30 p-2 rounded">
          <span class="font-semibold block text-blue-400/70 text-xs" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Will</span>
          <span class="text-blue-200" style="font-family: 'Crimson Text', serif;"><%= member.will %><% if will_mod != 0 %><span class="text-amber-400/70 text-xs ml-1">(<%= will_mod > 0 ? "+#{will_mod}" : will_mod.to_s %>)</span><% end %></span>
        </div>
        <% fate_mod = member.total_modifier("fate") %>
        <div class="bg-emerald-900/20 border border-emerald-800/30 p-2 rounded">
          <span class="font-semibold block text-emerald-400/70 text-xs" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Fate</span>
          <span class="text-emerald-200" style="font-family: 'Crimson Text', serif;"><%= member.fate %><% if fate_mod != 0 %><span class="text-amber-400/70 text-xs ml-1">(<%= fate_mod > 0 ? "+#{fate_mod}" : fate_mod.to_s %>)</span><% end %></span>
        </div>
      </div>
    <% end %>

    <!-- Tabs: Equipo / Skills -->
    <div class="border-t border-stone-800/50 mt-2 pt-4">
      <div class="flex gap-1 mb-4 border-b border-stone-800/60">
        <button onclick="showMemberTab(<%= member.id %>, 'equipo')" id="mc-tab-btn-equipo-<%= member.id %>"
                class="mc-tab-btn-<%= member.id %> px-4 py-2 text-emerald-400/80 border-b-2 border-emerald-600/60 -mb-px"
                style="font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase;">
          Equipo (<%= member.warband_equipments.size %>)
        </button>
        <button onclick="showMemberTab(<%= member.id %>, 'skills')" id="mc-tab-btn-skills-<%= member.id %>"
                class="mc-tab-btn-<%= member.id %> px-4 py-2 text-stone-400 border-b-2 border-transparent hover:text-stone-300 transition-colors -mb-px"
                style="font-family: 'Cinzel', serif; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase;">
          Skills (<%= member.warband_skills.size %>)
        </button>
      </div>

      <!-- Panel: Equipo -->
      <div id="mc-panel-equipo-<%= member.id %>" class="mc-panel-<%= member.id %>">
        <% if member.warband_equipments.any? %>
          <div class="divide-y divide-stone-800/50">
            <% member.warband_equipments.each do |equipment| %>
              <div class="py-2 flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-amber-100 truncate" style="font-family: 'Cinzel', serif; font-size: 0.8rem;"><%= equipment.name %></span>
                    <span class="px-1.5 py-0.5 text-xs text-blue-300/80 border border-blue-900/30 rounded bg-blue-900/15 shrink-0" style="font-family: 'Cinzel', serif; font-size: 0.55rem;"><%= equipment.display_type %></span>
                  </div>
                  <% if equipment.has_modifiers? %>
                    <p class="text-stone-500 text-xs mt-0.5" style="font-family: 'Crimson Text', serif;"><%= equipment.modifier_summary %></p>
                  <% end %>
                </div>
                <% if can_manage_warband?(@warband) %>
                  <div class="flex gap-1 shrink-0">
                    <%= link_to "✎", edit_warband_warband_member_warband_equipment_path(@warband, member, equipment),
                        class: "px-2 py-1 border border-amber-800/40 text-amber-400 rounded hover:bg-amber-900/20 transition-all",
                        style: "font-size: 0.7rem;" %>
                    <%= button_to "✕", warband_warband_member_warband_equipment_path(@warband, member, equipment),
                        method: :delete,
                        data: { turbo_confirm: "¿Eliminar #{equipment.name}?" },
                        class: "px-2 py-1 border border-red-800/40 text-red-400 rounded hover:bg-red-900/20 transition-all",
                        style: "font-size: 0.7rem;" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
          <% if can_manage_warband?(@warband) %>
            <div class="mt-3">
              <%= link_to "+ Añadir equipo", new_warband_warband_member_warband_equipment_path(@warband, member),
                  class: "text-emerald-400/70 hover:text-emerald-300 transition-colors",
                  style: "font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-stone-600 text-xs mb-2" style="font-family: 'Crimson Text', serif;">Sin equipo asignado.</p>
          <% if can_manage_warband?(@warband) %>
            <%= link_to "+ Añadir equipo", new_warband_warband_member_warband_equipment_path(@warband, member),
                class: "text-emerald-400/70 hover:text-emerald-300 transition-colors",
                style: "font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;" %>
          <% end %>
        <% end %>
      </div>

      <!-- Panel: Skills -->
      <div id="mc-panel-skills-<%= member.id %>" class="mc-panel-<%= member.id %> hidden">
        <% if member.warband_skills.any? %>
          <div class="divide-y divide-stone-800/50">
            <% member.warband_skills.each do |skill| %>
              <div class="py-2 flex items-start justify-between gap-3">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-amber-100 truncate" style="font-family: 'Cinzel', serif; font-size: 0.8rem;"><%= skill.name %></span>
                    <span class="px-1.5 py-0.5 text-xs text-purple-300/80 border border-purple-900/30 rounded bg-purple-900/15 shrink-0" style="font-family: 'Cinzel', serif; font-size: 0.55rem;"><%= skill.display_type %></span>
                  </div>
                  <% if skill.has_modifiers? %>
                    <p class="text-stone-500 text-xs mt-0.5" style="font-family: 'Crimson Text', serif;"><%= skill.modifier_summary %></p>
                  <% end %>
                </div>
                <% if can_manage_warband?(@warband) %>
                  <div class="flex gap-1 shrink-0">
                    <%= link_to "✎", edit_warband_warband_member_warband_skill_path(@warband, member, skill),
                        class: "px-2 py-1 border border-amber-800/40 text-amber-400 rounded hover:bg-amber-900/20 transition-all",
                        style: "font-size: 0.7rem;" %>
                    <%= button_to "✕", warband_warband_member_warband_skill_path(@warband, member, skill),
                        method: :delete,
                        data: { turbo_confirm: "¿Eliminar #{skill.name}?" },
                        class: "px-2 py-1 border border-red-800/40 text-red-400 rounded hover:bg-red-900/20 transition-all",
                        style: "font-size: 0.7rem;" %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
          <% if can_manage_warband?(@warband) %>
            <div class="mt-3">
              <%= link_to "+ Añadir skill", new_warband_warband_member_warband_skill_path(@warband, member),
                  class: "text-purple-400/70 hover:text-purple-300 transition-colors",
                  style: "font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-stone-600 text-xs mb-2" style="font-family: 'Crimson Text', serif;">Sin skills asignadas.</p>
          <% if can_manage_warband?(@warband) %>
            <%= link_to "+ Añadir skill", new_warband_warband_member_warband_skill_path(@warband, member),
                class: "text-purple-400/70 hover:text-purple-300 transition-colors",
                style: "font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase;" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-3 mt-4 pt-3 border-t border-stone-800/50">
      <%= link_to "Ver", warband_warband_member_path(@warband, member),
          class: "text-amber-400/80 hover:text-amber-300 text-sm transition-colors tracking-wider uppercase",
          style: "font-family: 'Cinzel', serif; font-size: 0.6rem;" %>
      <% if can_manage_warband?(@warband) %>
        <%= link_to "Editar", edit_warband_warband_member_path(@warband, member),
            class: "text-amber-400/80 hover:text-amber-300 text-sm transition-colors tracking-wider uppercase",
            style: "font-family: 'Cinzel', serif; font-size: 0.6rem;" %>
        <%= button_to "Eliminar", warband_warband_member_path(@warband, member),
            method: :delete,
            data: { turbo_confirm: "¿Estas seguro de eliminar a #{member.name}?" },
            class: "text-red-500/70 hover:text-red-400 text-sm transition-colors tracking-wider uppercase",
            style: "font-family: 'Cinzel', serif; font-size: 0.6rem;" %>
      <% end %>
    </div>
  </div>
</div>
