<% content_for(:body_class) { "bg-amber-50" } %>
<% content_for(:raw_content) { true } %>

<%= render layout: "shared/dark_layout", locals: { max_width: "max-w-3xl" } do %>
  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-10 gap-4">
    <div>
      <div class="flex items-center gap-4 mb-3">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-amber-700/60"></div>
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-amber-600/60" fill="currentColor">
          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
        </svg>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-amber-700/60"></div>
      </div>
      <h1 class="text-stone-800 tracking-[0.1em] uppercase" style="font-family: 'Cinzel', serif; font-size: 1.8rem; font-weight: 700;">
        Clasificación
      </h1>
      <p class="text-stone-500 mt-1" style="font-family: 'Crimson Text', serif;">
        <%= @campaign.name %>
      </p>
    </div>
    <div class="flex gap-3">
      <%= link_to campaign_path(@campaign), class: "px-4 py-2 border border-stone-300 text-stone-600 rounded hover:bg-amber-50/80 hover:border-stone-600/60 transition-all", style: "font-family: 'Cinzel', serif; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.7rem;" do %>
        Volver
      <% end %>
    </div>
  </div>

  <% if @standings.any? %>
    <!-- Leyenda de puntos -->
    <div class="flex gap-4 mb-6 text-xs text-stone-500" style="font-family: 'Cinzel', serif; font-size: 0.6rem; letter-spacing: 0.08em;">
      <span class="text-emerald-400/70">Victoria: 3 pts</span>
      <span class="text-amber-600">Empate: 1 pt</span>
      <span class="text-red-400/70">Derrota: 0 pts</span>
    </div>

    <!-- Tabla -->
    <div class="rounded-lg border border-amber-300/60 bg-gradient-to-b from-white to-amber-50/60 overflow-hidden">
      <table class="w-full">
        <thead>
          <tr class="border-b border-amber-300/60 bg-white/80">
            <th class="px-4 py-3 text-left text-stone-700/60 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem; width: 2.5rem;">#</th>
            <th class="px-4 py-3 text-left text-stone-700/60 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Warband</th>
            <th class="px-4 py-3 text-center text-stone-700/60 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">PJ</th>
            <th class="px-4 py-3 text-center text-emerald-400/70 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">V</th>
            <th class="px-4 py-3 text-center text-amber-600 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">E</th>
            <th class="px-4 py-3 text-center text-red-400/70 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">D</th>
            <th class="px-4 py-3 text-center text-stone-800 tracking-wider uppercase" style="font-family: 'Cinzel', serif; font-size: 0.6rem;">Pts</th>
          </tr>
        </thead>
        <tbody>
          <% @standings.each_with_index do |entry, i| %>
            <tr class="border-b border-stone-800/30 <%= i == 0 ? 'bg-amber-100/40' : 'hover:bg-stone-100/60' %> transition-colors">
              <td class="px-4 py-3 text-center">
                <% if i == 0 %>
                  <svg viewBox="0 0 24 24" class="w-4 h-4 text-amber-700 mx-auto" fill="currentColor">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                <% else %>
                  <span class="text-stone-500" style="font-family: 'Cinzel', serif; font-size: 0.75rem;"><%= i + 1 %></span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <span class="text-stone-800" style="font-family: 'Cinzel', serif; font-size: 0.85rem;"><%= entry[:warband].name %></span>
                <span class="text-stone-500 text-xs ml-2" style="font-family: 'Crimson Text', serif;"><%= entry[:warband].user.name %></span>
              </td>
              <td class="px-4 py-3 text-center text-stone-600" style="font-family: 'Crimson Text', serif;"><%= entry[:played] %></td>
              <td class="px-4 py-3 text-center text-emerald-400" style="font-family: 'Crimson Text', serif;"><%= entry[:wins] %></td>
              <td class="px-4 py-3 text-center text-amber-700" style="font-family: 'Crimson Text', serif;"><%= entry[:draws] %></td>
              <td class="px-4 py-3 text-center text-red-400/70" style="font-family: 'Crimson Text', serif;"><%= entry[:losses] %></td>
              <td class="px-4 py-3 text-center">
                <span class="font-bold text-stone-800" style="font-family: 'Cinzel', serif; font-size: 1rem;"><%= entry[:points] %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-amber-300/60 bg-gradient-to-b from-white to-amber-50/60 p-12 text-center">
      <p class="text-stone-600" style="font-family: 'Crimson Text', serif; font-size: 1.05rem;">
        Aún no hay partidas jugadas en esta campaña.
      </p>
    </div>
  <% end %>
<% end %>
